{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "tests/e2e/**/*.ts",
    "vite.*.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
